# =============================================================================
# Copy this file to ".env" and fill in the values you need.
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
# Never commit your real .env -- it is git-ignored.
# =============================================================================

# --- Gateway auth (REQUIRED) -------------------------------------------------
# The single key your clients (Cursor/VSCode/Antigravity/chat UI) use to talk to
# the gateway. Generate strong random values, e.g.:
#   python -c "import secrets; print('sk-'+secrets.token_hex(24))"
LITELLM_MASTER_KEY=sk-CHANGE-ME-master-key
# Used by LiteLLM to encrypt provider keys stored in the DB. Any random string.
LITELLM_SALT_KEY=CHANGE-ME-salt-key

# --- Datastores (REQUIRED) ---------------------------------------------------
POSTGRES_PASSWORD=CHANGE-ME-postgres-password
# Secret used by Open WebUI to sign sessions. Any random string.
WEBUI_SECRET_KEY=CHANGE-ME-webui-secret

# --- Cloud provider keys (set only the ones you use) -------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- freellm local proxy (see "freellm"/"freellm-embed" in config) -----------
# Local OpenAI-compatible proxy, default at 127.0.0.1:31415.
FREELLM_API_KEY=

# --- Custom OpenAI-compatible endpoint (see "my-custom-endpoint" in config) --
CUSTOM_API_KEY=

# --- OpenHands autonomous agent (optional; only the "agent" profile) ----------
# Start it with:  docker compose --profile agent up -d   -> http://localhost:3100
# Defaults below point the agent at the gateway; override if you want.
OPENHANDS_VERSION=1.8
OPENHANDS_AGENT_SERVER_TAG=1.26.0-python
OPENHANDS_LLM_BASE_URL=http://host.docker.internal:4000/v1
# Defaults to LITELLM_MASTER_KEY if left blank.
OPENHANDS_LLM_API_KEY=
# A model_name from litellm/config.yaml, prefixed with openai/ (gateway is OpenAI-compatible).
OPENHANDS_LLM_MODEL=openai/freellm
